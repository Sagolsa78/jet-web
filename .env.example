# ─────────────────────────────────────────────────────────────
# JETO VACATIONS - ENVIRONMENT CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────

# Optional: Jeto Live CRM API Base URL
# When left empty, the site automatically operates in honest Demo Mode in development,
# validating inputs locally and indicating demo status to users.
# Example: https://crm-api.jetovacations.com/api
JETO_CRM_API_BASE_URL=

# Optional: Jeto CRM Ingestion Webhook URL
# If provided, all callback leads and enquiries are POSTed here with HMAC-SHA256 signatures.
# Example: https://crm.jetovacations.com/webhooks/lead-intake
CRM_WEBHOOK_URL=

# Optional: Shared Secret for Webhook Payload Verification
# When set, outbound webhook requests include X-Jeto-Signature: sha256=<hmac_hex> and X-Jeto-Timestamp headers.
CRM_WEBHOOK_SECRET=

# Explicit Demo Mode Toggle (true / false)
# In development/test: defaults to true unless DEMO_ENQUIRY_MODE is set to 'false'.
# In production: must be explicitly 'true' to allow demo simulation. If false and no CRM URL is provided,
# the system safely blocks false success notices and routes visitors to telephone/WhatsApp concierge.
DEMO_ENQUIRY_MODE=true

# Public Brand & Contact Overrides (defaults to Jeto production contact)
NEXT_PUBLIC_JETO_PHONE=8882579628
NEXT_PUBLIC_JETO_EMAIL=support@jetovacations.com
NEXT_PUBLIC_JETO_GSTIN=07AAECJ6467D1ZI
